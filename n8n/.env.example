# n8n Environment Variables
# Copy to .env on the VPS and fill in real values

# Domain where n8n will be accessible
N8N_HOST=n8n.yourdomain.com

# Timezone for cron schedules
GENERIC_TIMEZONE=Asia/Jerusalem

# Strong random key used by n8n to encrypt credentials.
# Generate with: openssl rand -base64 48
N8N_ENCRYPTION_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING

# Supabase (service_role key - keep secret)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# AI / APIs
GEMINI_API_KEY=YOUR_GEMINI_KEY
DEEPL_API_KEY=YOUR_DEEPL_KEY
FIRECRAWL_API_KEY=YOUR_FIRECRAWL_API_KEY
YOUTUBE_DATA_API_KEY=YOUR_YOUTUBE_KEY

# Frontend (Vercel)
NEXT_PUBLIC_SITE_URL=https://your-vercel-site.com
REVALIDATE_SECRET=YOUR_VERCEL_REVALIDATE_SECRET
