      "id": "log-ai-error-v2",
      "name": "Log AI Error",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [2050, 300],
      "credentials": {
        "supabaseApi": "supabase-service-role"
      }
    },
    {
      "parameters": {
        "jsCode": "const article = $input.first().json;\nconst translations = article.translations_json;\nconst langs = ['en', 'he', 'es', 'ar'];\nconst articleId = article.id;\nconst categorySlug = article.detected_category_slug;\n\nconst rows = langs.map((lang) => {\n  const t = translations[lang];\n  const body = t.executive_summary;\n  const wc = body ? body.split(/\\s+/).filter(Boolean).length : 0;\n  \n  return {\n    json: {\n      article_id: articleId,\n      language: lang,\n      title: t.title,\n      seo_slug: t.seo_slug || article.detected_category_slug + '-' + article.id.slice(0,8),\n      seo_meta_title: t.title.slice(0, 70),\n      seo_meta_description: (t.seo_meta_description || body || '').slice(0, 160),\n      summary: {\n        executive_summary: body,\n        key_takeaways: Array.isArray(t.key_takeaways) ? t.key_takeaways : [t.key_takeaways],\n        body: body\n      },\n      tags: Array.isArray(t.tags) ? t.tags : [],\n      word_count: wc,\n      is_primary: lang === article.original_language || lang === 'en'\n    }\n  };\n});\n\nreturn rows;"
      },
      "id": "build-translations-v2",
      "name": "Build Translations",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1850, 500]
