        "supabaseApi": "supabase-service-role"
      }
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "split-batches-v2",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [650, 300]
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "articles",
        "matchColumnsUi": {
          "mode": "single",
          "value": "id"
        },
        "dataMode": "define",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "id", "fieldValue": "={{ $json.id }}" },
            { "fieldId": "status", "fieldValue": "extracting" },
            { "fieldId": "processing_started_at", "fieldValue": "={{ $now }}" }
          ]
        }
      },
      "id": "update-extracting-v2",
      "name": "Set Extracting",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [850, 300],
      "credentials": {
        "supabaseApi": "supabase-service-role"
      }
    },
    {
      "parameters": {
        "jsCode": "const article = $input.first().json;\nconst url = article.source_url;\nconst firecrawlKey = $getEnvironmentVariable('FIRECRAWL_API_KEY');\nconst jinaTimeoutMs = 20000;\n\nasync function fetchWithJina(targetUrl) {\n  const clean = targetUrl.replace(/^https?:\\/\\//, '');\n  const jinaUrl = `https://r.jina.ai/http://${clean}`;\n  const res = await $httpRequest({\n    method: 'GET',\n    url: jinaUrl,\n    responseFormat: 'text',\n    timeout: jinaTimeoutMs\n  });\n  return typeof res === 'string' ? res : String(res);\n}\n\nasync function fetchWithFirecrawl(targetUrl) {\n  const res = await $httpRequest({\n    method: 'POST',\n    url: 'https://api.firecrawl.dev/v1/scrape',\n    headers: {\n      'Authorization': `Bearer ${firecrawlKey}`,\n      'Content-Type': 'application/json'\n    },\n    body: {\n      url: targetUrl,\n      formats: ['markdown']\n    },\n    responseFormat: 'json',\n    timeout: 30000\n  });\n  return res?.data?.markdown || res?.markdown || '';\n}\n\nasync function fetchYouTubeTranscript(videoUrl) {\n  // Placeholder: YouTube transcript extraction requires external service or library\n  // In production, integrate youtube-transcript-api via a Function node or custom image\n  return '';\n}\n\nlet text = '';\nlet extractionMethod = '';\nlet errorMsg = '';\n\ntry {\n  text = await fetchWithJina(url);\n  extractionMethod = 'jina';\n} catch (e1) {\n  try {\n    text = await fetchWithFirecrawl(url);\n    extractionMethod = 'firecrawl';\n  } catch (e2) {\n    if (article.source_type === 'video') {\n      try {\n        text = await fetchYouTubeTranscript(url);\n        extractionMethod = 'youtube-transcript';\n      } catch (e3) {\n        errorMsg = `Extraction failed: ${e3.message}`;\n      }\n    } else {\n      errorMsg = `Extraction failed: ${e2.message}`;\n    }\n  }\n}\n\nconst cleaned = text.replace(/\\s+/g, ' ').trim();\nconst maxLen = 12000;\nconst truncated = cleaned.length > maxLen ? cleaned.slice(0, maxLen) + '...' : cleaned;\n\nif (!truncated || truncated.length < 200) {\n  errorMsg = errorMsg || 'Extracted text too short or empty';\n}\n\nreturn [{\n  json: {\n    ...article,\n    extracted_text: truncated,\n    extraction_method: extractionMethod,\n    extraction_error: errorMsg || null\n  }\n}];"
      },
      "id": "extract-text-v2",
      "name": "Extract Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nif (item.extraction_error) {\n  return [{ json: { ...item, step_failed: 'extract' } }];\n}\nreturn [];"
      },
      "id": "route-extract-error-v2",
      "name": "Extract Failed?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 100],
      "continueOnFail": false
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "articles",
        "matchColumnsUi": {
          "mode": "single",
          "value": "id"
        },
        "dataMode": "define",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "id", "fieldValue": "={{ $json.id }}" },
            { "fieldId": "status", "fieldValue": "failed" },
            { "fieldId": "raw_metadata", "fieldValue": "={{ JSON.stringify({ error: $json.extraction_error, step: $json.step_failed }) }}" }
          ]
        }
      },
      "id": "mark-failed-extract-v2",
      "name": "Mark Failed Extract",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1450, 100],
      "credentials": {
        "supabaseApi": "supabase-service-role"
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "tableId": "processing_logs",
        "dataMode": "define",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "article_id", "fieldValue": "={{ $json.id }}" },
            { "fieldId": "step", "fieldValue": "extract" },
            { "fieldId": "status", "fieldValue": "error" },
            { "fieldId": "message", "fieldValue": "={{ $json.extraction_error }}" }
          ]
        }
      },
      "id": "log-extract-error-v2",
      "name": "Log Extract Error",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1650, 100],
      "credentials": {
        "supabaseApi": "supabase-service-role"
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key={{ $getEnvironmentVariable('GEMINI_API_KEY') }}",
        "sendBody": true,
        "contentType": "json",
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "contents",
              "value": "=[{\"role\":\"user\",\"parts\":[{\"text\":\"Read the article below and produce a JSON object with summaries in 4 languages: en, he, es, ar. For each language provide: title (max 70 chars, catchy), executive_summary (2-3 paragraphs), key_takeaways (array of 3-5 strings), tags (array of 3-7 relevant strings), category_slug (choose one: technology, business, science, health, world, entertainment, sports), seo_slug (URL-safe, max 80 chars, ASCII only), seo_meta_description (max 160 chars).\\n\\nArticle text:\\n{{ $json.extracted_text }}\\n\\nReturn ONLY valid JSON in this exact shape:\\n{\\\"en\\\":{\\\"title\\\":\\\"...\\\",\\\"executive_summary\\\":\\\"...\\\",\\\"key_takeaways\\\":[\\\"...\\\"],\\\"tags\\\":[\\\"...\\\"],\\\"category_slug\\\":\\\"...\\\",\\\"seo_slug\\\":\\\"...\\\",\\\"seo_meta_description\\\":\\\"...\\\"},\\\"he\\\":{...},\\\"es\\\":{...},\\\"ar\\\":{...}}\"}]}]"
            },
            {
              "name": "generationConfig",
              "value": "={\"responseMimeType\":\"application/json\",\"temperature\":0.3}"
            }
          ]
        },
        "options": {
          "responseFormat": "json"
        }
      },
      "id": "gemini-summarize-v2",
      "name": "Gemini Summarize + Translate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "jsCode": "const article = $input.first().json;\nconst gemini = $input.all()[1]?.json;\n\ntry {\n  let text = gemini?.candidates?.[0]?.content?.parts?.[0]?.text || '';\n  text = text.replace(/^```json\\s*/i, '').replace(/```$/, '').trim();\n  \n  if (!text) throw new Error('Empty Gemini response');\n  \n  const parsed = JSON.parse(text);\n  const requiredLangs = ['en', 'he', 'es', 'ar'];\n  \n  for (const lang of requiredLangs) {\n    if (!parsed[lang]) throw new Error(`Missing translation for ${lang}`);\n    if (!parsed[lang].title || !parsed[lang].executive_summary) {\n      throw new Error(`Incomplete translation for ${lang}`);\n    }\n  }\n  \n  // Fallback category\n  const validCategories = ['technology', 'business', 'science', 'health', 'world', 'entertainment', 'sports'];\n  const categorySlug = validCategories.includes(parsed.en.category_slug) ? parsed.en.category_slug : 'technology';\n  \n  return [{\n    json: {\n      ...article,\n      translations_json: parsed,\n      detected_category_slug: categorySlug,\n      ai_error: null\n    }\n  }];\n} catch (err) {\n  return [{\n    json: {\n      ...article,\n      ai_error: err.message,\n      raw_gemini_response: JSON.stringify(gemini)\n    }\n  }];\n}"
      },
      "id": "parse-ai-output-v2",
      "name": "Parse AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nif (item.ai_error) {\n  return [{ json: { ...item, step_failed: 'ai' } }];\n}\nreturn [];"
      },
      "id": "route-ai-error-v2",
      "name": "AI Failed?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1650, 300],
      "continueOnFail": false
    },
    {
      "parameters": {
        "operation": "update",
